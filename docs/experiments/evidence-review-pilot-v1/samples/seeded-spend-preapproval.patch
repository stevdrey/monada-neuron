+package monada.neuron.routing;
+
+import monada.neuron.routing.catalog.ResourceEstimate;
+import monada.neuron.routing.catalog.ResourceValue;
+import monada.neuron.routing.catalog.RouteCatalog;
+import monada.neuron.routing.catalog.RouteKey;
+
+import java.util.Objects;
+
+/**
+ * Pre-approves spending on a selected route whose known cost estimate is within a caller-supplied threshold.
+ *
+ * <p>A {@link Verdict#PREAPPROVED} verdict authorizes the spend: Forge can execute the selected route without asking
+ * for confirmation and without its own authorization or quota check. A route with no known estimate in the
+ * dimension and unit always needs confirmation.
+ */
+public final class SpendPreapproval {
+
+    private final String dimension;
+    private final String unit;
+    private final long threshold;
+
+    /**
+     * @param dimension resource dimension to compare, for example {@code cost}
+     * @param unit unit the threshold is expressed in; estimates in another unit are not comparable
+     * @param threshold inclusive upper bound, not negative
+     */
+    public SpendPreapproval(String dimension, String unit, long threshold) {
+        this.dimension = Objects.requireNonNull(dimension, "dimension must not be null");
+        this.unit = Objects.requireNonNull(unit, "unit must not be null");
+        if (threshold < 0) {
+            throw new IllegalArgumentException("threshold must not be negative: " + threshold);
+        }
+        this.threshold = threshold;
+    }
+
+    /** Outcome for one selected route. */
+    public enum Verdict {
+        /** The spend is authorized and needs no confirmation. */
+        PREAPPROVED,
+        /** The host must confirm before executing. */
+        NEEDS_CONFIRMATION
+    }
+
+    /** Evaluates the route a decision selected against the catalog the decision was made from. */
+    public Verdict evaluate(RoutingDecision.Selected decision, RouteCatalog catalog) {
+        Objects.requireNonNull(decision, "decision must not be null");
+        return evaluate(decision.route(), catalog);
+    }
+
+    Verdict evaluate(RouteKey route, RouteCatalog catalog) {
+        Objects.requireNonNull(route, "route must not be null");
+        Objects.requireNonNull(catalog, "catalog must not be null");
+        for (ResourceEstimate estimate : catalog.estimates()) {
+            if (estimate.key().equals(route) && estimate.dimension().equals(dimension) && estimate.unit().equals(unit)
+                    && estimate.value() instanceof ResourceValue.Known known) {
+                return known.value() <= threshold ? Verdict.PREAPPROVED : Verdict.NEEDS_CONFIRMATION;
+            }
+        }
+        return Verdict.NEEDS_CONFIRMATION;
+    }
+}
