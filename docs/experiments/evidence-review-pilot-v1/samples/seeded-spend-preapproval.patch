+package monada.neuron.routing;
+
+import monada.neuron.routing.catalog.ResourceValue;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static monada.neuron.routing.RoutingFixtures.API_X;
+import static monada.neuron.routing.RoutingFixtures.SUB_A;
+import static monada.neuron.routing.RoutingFixtures.cost;
+import static monada.neuron.routing.RoutingFixtures.demo;
+import static monada.neuron.routing.RoutingFixtures.demoWith;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class SpendPreapprovalTest {
+
+    private final SpendPreapproval preapproval = new SpendPreapproval("cost", "usd-cents", 100);
+
+    @Test
+    void routeWithinTheThresholdIsPreapproved() {
+        var catalog = demoWith(List.of(cost(SUB_A, 100, "usd-cents"), cost(API_X, 101, "usd-cents")));
+        assertEquals(SpendPreapproval.Verdict.PREAPPROVED, preapproval.evaluate(SUB_A, catalog));
+    }
+
+    @Test
+    void routeAboveTheThresholdNeedsConfirmation() {
+        var catalog = demoWith(List.of(cost(API_X, 101, "usd-cents")));
+        assertEquals(SpendPreapproval.Verdict.NEEDS_CONFIRMATION, preapproval.evaluate(API_X, catalog));
+    }
+
+    @Test
+    void missingUnknownOrOtherUnitEstimateNeedsConfirmation() {
+        assertEquals(SpendPreapproval.Verdict.NEEDS_CONFIRMATION, preapproval.evaluate(SUB_A, demo()));
+        assertEquals(SpendPreapproval.Verdict.NEEDS_CONFIRMATION,
+                preapproval.evaluate(SUB_A, demoWith(List.of(cost(SUB_A, new ResourceValue.Unknown())))));
+        assertEquals(SpendPreapproval.Verdict.NEEDS_CONFIRMATION,
+                preapproval.evaluate(SUB_A, demoWith(List.of(cost(SUB_A, 1, "eur-cents")))));
+    }
+
+    @Test
+    void negativeThresholdIsRejected() {
+        assertThrows(IllegalArgumentException.class, () -> new SpendPreapproval("cost", "usd-cents", -1));
+    }
+}
